{
  "info": {
    "name": "TODO API",
    "description": "Minimal Express TODO REST API. Set `baseUrl` to http://localhost:3000 or your Render URL. Create a todo first so later requests reuse `todoId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/healthz"
      }
    },
    {
      "name": "Create todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json._id) pm.collectionVariables.set('todoId', json._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ship to Render\",\n  \"completed\": false\n}"
        },
        "url": "{{baseUrl}}/todos"
      }
    },
    {
      "name": "List todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/todos"
      }
    },
    {
      "name": "Get todo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/todos/{{todoId}}"
      }
    },
    {
      "name": "Update todo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        },
        "url": "{{baseUrl}}/todos/{{todoId}}"
      }
    },
    {
      "name": "Delete todo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/todos/{{todoId}}"
      }
    }
  ]
}
